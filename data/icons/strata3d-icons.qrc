    <file alias="lucide/rotate-3d.svg">lucide/rotate-3d.svg</file>
    <file alias="lucide/shield-check.svg">lucide/shield-check.svg</file>
    <file alias="lucide/table-2.svg">lucide/table-2.svg</file>
