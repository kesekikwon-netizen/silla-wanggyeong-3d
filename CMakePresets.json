{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "vs",
      "displayName": "Visual Studio 2022 (hgis 와 같은 구성)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "OSGEO4W_ROOT": "$env{OSGEO4W_ROOT}"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "vs", "configuration": "Release" },
    { "name": "debug", "configurePreset": "vs", "configuration": "Debug" }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "vs",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
